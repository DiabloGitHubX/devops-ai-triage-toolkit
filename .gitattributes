
* text=auto

*.sh text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf

# CI log fixtures
*.log text eol=lf

*.ini text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
.env*.example text eol=lf
.gitattributes text eol=lf

# Preserve original formal evaluation artifacts byte-for-byte.
# Generated diagnoses and traces may contain original CRLF line
# endings and whitespace that must not be modified by Git.
docs/evaluation/baseline.json -text !eol
docs/evaluation/results.json -text !eol
docs/evaluation/report.md -text !eol
docs/evaluation/cases/** -text !eol whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof,-space-before-tab

# Preserve original container verification evidence.
docs/container-verification/attempt-*/** -text !eol whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof,-space-before-tab
